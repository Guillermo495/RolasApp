<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entidades="using:RolasApp.Modelo.Entidades"
        x:Class="RolasApp.Vista.MainWindow"
        Title="RolasApp - Gestor de Colección Musical"
        Width="1120" Height="660"
        MinWidth="920" MinHeight="520"
        Background="#1E1E2E"
        Foreground="#CDD6F4">

    <Grid RowDefinitions="Auto, *, Auto" Margin="16">

        <!-- Buscador, gestion de interpretes y botones de minado -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto, Auto, Auto" Margin="0,0,0,14">
            <TextBox x:Name="CajaBusqueda"
                     Grid.Column="0"
                     PlaceholderText="Buscar por título, intérprete, álbum, género o año..."
                     Background="#313244"
                     Foreground="#CDD6F4"
                     BorderBrush="#45475A"
                     CornerRadius="6"
                     Padding="10,8"
                     TextChanged="AlCambiarBusqueda" />

            <Button x:Name="BotonLimpiar"
                    Grid.Column="1"
                    Content="Limpiar"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Background="#45475A"
                    Foreground="#CDD6F4"
                    CornerRadius="6"
                    Click="AlPulsarLimpiar" />

            <Button x:Name="BotonInterpretes"
                    Grid.Column="2"
                    Content="Intérpretes y Bandas..."
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Background="#F9E2AF"
                    Foreground="#11111B"
                    FontWeight="Bold"
                    CornerRadius="6"
                    Click="AlPulsarInterpretes" />

            <Button x:Name="BotonElegirDirectorio"
                    Grid.Column="3"
                    Content="Elegir Directorio..."
                    Margin="8,0,0,0"
                    Padding="14,8"
                    Background="#CBA6F7"
                    Foreground="#11111B"
                    FontWeight="Bold"
                    CornerRadius="6"
                    Click="AlPulsarElegirDirectorio" />

            <Button x:Name="BotonMinar"
                    Grid.Column="4"
                    Content="Minar ~/Música"
                    Margin="8,0,0,0"
                    Padding="16,8"
                    Background="#89B4FA"
                    Foreground="#11111B"
                    FontWeight="Bold"
                    CornerRadius="6"
                    Click="AlPulsarMinar" />
        </Grid>

        <!-- Lista de rolas a la izquierda y editor a la derecha -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 340">

            <!-- Tabla de rolas -->
            <Border Grid.Column="0"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,14,0"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto, *">

                    <!-- Encabezados de las columnas -->
                    <Border Grid.Row="0" Background="#313244" Padding="12,10">
                        <Grid ColumnDefinitions="50, 2*, 1.5*, 1.5*, 65, 1*">
                            <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="1" Text="Título" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="2" Text="Intérprete" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="3" Text="Álbum" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="4" Text="Año" FontWeight="Bold" Foreground="#A6ADC8" />
                            <TextBlock Grid.Column="5" Text="Género" FontWeight="Bold" Foreground="#A6ADC8" />
                        </Grid>
                    </Border>

                    <!-- Lista desplazable de rolas con efecto cebra tipo Finder -->
                    <ListBox x:Name="ListaRolas"
                             Grid.Row="1"
                             Background="Transparent"
                             SelectionChanged="AlSeleccionarRola">

                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>

                            <Style Selector="ListBoxItem:nth-child(2n+1)">
                                <Setter Property="Background" Value="#181825" />
                            </Style>

                            <Style Selector="ListBoxItem:nth-child(2n)">
                                <Setter Property="Background" Value="#222336" />
                            </Style>

                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#313244" />
                            </Style>

                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#45475A" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="entidades:Rola">
                                <Grid ColumnDefinitions="50, 2*, 1.5*, 1.5*, 65, 1*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Pista}" Foreground="#A6ADC8" />
                                    <TextBlock Grid.Column="1" Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding NombreInterprete}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding NombreAlbum}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Anio}" Foreground="#A6ADC8" />
                                    <TextBlock Grid.Column="5" Text="{Binding Genero}" Foreground="#89DCEB" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Visores APIC y editor de datos en SQLite -->
            <Border Grid.Column="1"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Detalles de la Rola y Álbum"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />

                        <!-- Recuadros para Portada Frontal y Foto del Artista (APIC) -->
                        <Grid ColumnDefinitions="*, 12, *" Margin="0,4">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Portada"
                                           FontSize="11"
                                           Foreground="#A6ADC8"
                                           HorizontalAlignment="Center" />
                                <Border Width="135" Height="135"
                                        Background="#313244"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="TextoSinPortada"
                                                   Text="Sin Portada"
                                                   FontSize="11"
                                                   Foreground="#6C7086"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="ImagenPortada"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Artista"
                                           FontSize="11"
                                           Foreground="#A6ADC8"
                                           HorizontalAlignment="Center" />
                                <Border Width="135" Height="135"
                                        Background="#313244"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <TextBlock x:Name="TextoSinArtista"
                                                   Text="Sin Foto"
                                                   FontSize="11"
                                                   Foreground="#6C7086"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="ImagenArtista"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Campos editables en la base de datos -->
                        <TextBlock Text="Título:" FontSize="12" Foreground="#A6ADC8" />
                        <TextBox x:Name="CampoTitulo" Background="#313244" Foreground="#CDD6F4" />

                        <TextBlock Text="Intérprete:" FontSize="12" Foreground="#A6ADC8" />
                        <TextBox x:Name="CampoInterprete" Background="#313244" Foreground="#CDD6F4" />

                        <TextBlock Text="Álbum:" FontSize="12" Foreground="#A6ADC8" />
                        <TextBox x:Name="CampoAlbum" Background="#313244" Foreground="#CDD6F4" />

                        <Grid ColumnDefinitions="*, 10, *">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Pista:" FontSize="12" Foreground="#A6ADC8" />
                                <TextBox x:Name="CampoPista" Background="#313244" Foreground="#CDD6F4" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Año (Pista / Álbum):" FontSize="12" Foreground="#A6ADC8" />
                                <TextBox x:Name="CampoAnio" Background="#313244" Foreground="#CDD6F4" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Género:" FontSize="12" Foreground="#A6ADC8" />
                        <TextBox x:Name="CampoGenero" Background="#313244" Foreground="#CDD6F4" />

                        <TextBlock Text="Ruta del directorio MP3:" FontSize="12" Foreground="#A6ADC8" />
                        <TextBox x:Name="CampoRuta"
                                 IsReadOnly="True"
                                 Background="#11111B"
                                 Foreground="#6C7086"
                                 FontSize="11" />

                        <!-- Botones de accion sobre la rola seleccionada -->
                        <Grid ColumnDefinitions="*, 8, *" Margin="0,8,0,0">
                            <Button x:Name="BotonGuardar"
                                    Grid.Column="0"
                                    Content="Guardar en BD"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="#A6E3A1"
                                    Foreground="#11111B"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    IsEnabled="False"
                                    Click="AlPulsarGuardar" />

                            <Button x:Name="BotonEliminar"
                                    Grid.Column="2"
                                    Content="Eliminar"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="#F38BA8"
                                    Foreground="#11111B"
                                    FontWeight="Bold"
                                    CornerRadius="6"
                                    IsEnabled="False"
                                    Click="AlPulsarEliminar" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Estado y barra de progreso -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 220" Margin="0,12,0,0">
            <TextBlock x:Name="EtiquetaEstado"
                       Grid.Column="0"
                       Text="Listo."
                       Foreground="#A6ADC8"
                       VerticalAlignment="Center" />

            <ProgressBar x:Name="BarraProgreso"
                         Grid.Column="1"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="14"
                         CornerRadius="4"
                         Foreground="#89B4FA"
                         Background="#313244"
                         IsVisible="False" />
        </Grid>

    </Grid>
</Window>